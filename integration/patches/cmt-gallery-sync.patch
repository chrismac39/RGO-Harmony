+def load_gallery_images(config):
+    """Return validated gallery files in deterministic filename order."""
+    directory = config.get(WORKSHOP_GALLERY_DIR_KEY, DEFAULT_WORKSHOP_GALLERY_DIR)
+    if not isinstance(directory, str) or not directory.strip():
+        print(f"Error: {WORKSHOP_GALLERY_DIR_KEY} must be a non-empty path in config.toml.")
+        return None
+
+    if not os.path.isabs(directory):
+        directory = os.path.join(ROOT_DIR, directory)
+    directory = os.path.abspath(directory)
+    if not os.path.isdir(directory):
+        print(f"Error: Workshop gallery directory not found: {directory}")
+        return None
+
+    try:
+        with os.scandir(directory) as scan:
+            entries = sorted(
+                scan,
+                key=lambda entry: (entry.name.casefold(), entry.name),
+            )
+    except OSError as exc:
+        print(f"Error: Could not read Workshop gallery directory '{directory}': {exc}")
+        return None
+
+    image_paths = []
+    for entry in entries:
+        try:
+            is_directory = entry.is_dir(follow_symlinks=False)
+        except OSError as exc:
+            print(f"Error: Could not inspect Workshop gallery entry '{entry.path}': {exc}")
+            return None
+        if is_directory:
+            continue
+
+        extension = os.path.splitext(entry.name)[1].lower()
+        if extension not in GALLERY_IMAGE_EXTENSIONS:
+            print(
+                f"Error: Unsupported file in Workshop gallery directory: "
+                f"{entry.path}. Use JPG, JPEG, or PNG files only."
+            )
+            return None
+        if not entry.is_file(follow_symlinks=True):
+            print(f"Error: Workshop gallery image is not a regular file: {entry.path}")
+            return None
+
+        try:
+            file_size = entry.stat(follow_symlinks=True).st_size
+            with open(entry.path, "rb") as image_file:
+                header = image_file.read(24)
+        except OSError as exc:
+            print(f"Error: Could not read Workshop gallery image '{entry.path}': {exc}")
+            return None
+
+        if file_size >= MAX_GALLERY_IMAGE_BYTES:
+            print(
+                f"Error: Workshop gallery image must be smaller than 1 MB: "
+                f"{entry.path}"
+            )
+            return None
+
+        if extension == ".png":
+            valid_format = (
+                len(header) >= 24
+                and header.startswith(PNG_SIGNATURE)
+                and header[12:16] == b"IHDR"
+                and int.from_bytes(header[16:20], "big") > 0
+                and int.from_bytes(header[20:24], "big") > 0
+            )
+        else:
+            valid_format = header.startswith(b"\xff\xd8\xff")
+
+        if not valid_format:
+            print(
+                f"Error: Workshop gallery image content does not match its "
+                f"'{extension}' extension: {entry.path}"
+            )
+            return None
+
+        image_paths.append(os.path.abspath(entry.path))
+
+    if not image_paths:
+        print(
+            f"Error: Workshop gallery directory contains no images: {directory}. "
+            "An empty gallery is not synchronized to avoid deleting remote images."
+        )
+        return None
+
+    return image_paths
