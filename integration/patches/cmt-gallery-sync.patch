new file mode 100644
index 0000000..3bf2890
--- /dev/null
+++ b/tools/steamworks/gallery.py
@@ -0,0 +1,343 @@
+import ctypes
+import os
+import sys
+import time
+from ctypes import (
+    CFUNCTYPE,
+    POINTER,
+    Structure,
+    c_bool,
+    c_char,
+    c_char_p,
+    c_int,
+    c_uint8,
+    c_uint32,
+    c_uint64,
+    c_void_p,
+    byref,
+    cast,
+    create_string_buffer,
+    pointer,
+    sizeof,
+    string_at,
+)
+from typing import NamedTuple
+
+from steamworks.enums import EItemPreviewType
+
+
+STEAMWORKS_UGC_INTERFACE = "SteamAPI_SteamUGC_v016"
+STEAM_UGC_QUERY_COMPLETED_CALLBACK_ID = 3401
+QUERY_TIMEOUT_SECONDS = 30
+QUERY_POLL_INTERVAL_SECONDS = 0.1
+PREVIEW_URL_BUFFER_SIZE = 4096
+PREVIEW_FILENAME_BUFFER_SIZE = 1024
+
+
+class SteamWorkshopGalleryError(Exception):
+    pass
+
+
+class WorkshopPreview(NamedTuple):
+    filename: str
+    preview_type: int
+    url: str
+
+
+class _SteamUGCQueryCompleted(Structure):
+    _fields_ = [
+        ("handle", c_uint64),
+        ("result", c_int),
+        ("num_results_returned", c_uint32),
+        ("total_matching_results", c_uint32),
+        ("cached_data", c_bool),
+        ("next_cursor", c_char * 256),
+    ]
+
+
+_CALLBACK_RUN = CFUNCTYPE(None, c_void_p, c_void_p)
+_CALLBACK_RUN_WITH_RESULT = CFUNCTYPE(None, c_void_p, c_void_p, c_bool, c_uint64)
+_CALLBACK_SIZE = CFUNCTYPE(c_int, c_void_p)
+
+
+def _steamworks_library_path(module_file, library_name):
+    module_directory = os.path.dirname(os.path.abspath(module_file))
+    tools_directory = os.path.dirname(module_directory)
+    if os.path.basename(tools_directory) == "dependencies":
+        tools_directory = os.path.dirname(tools_directory)
+    return os.path.join(tools_directory, "dependencies", library_name)
+
+
+class _CallbackVTable(Structure):
+    _fields_ = [
+        ("run", _CALLBACK_RUN),
+        ("run_with_result", _CALLBACK_RUN_WITH_RESULT),
+        ("get_callback_size", _CALLBACK_SIZE),
+    ]
+
+
+class _CallbackBase(Structure):
+    _fields_ = [
+        ("vtable", POINTER(_CallbackVTable)),
+        ("flags", c_uint8),
+        ("callback_id", c_int),
+    ]
+
+
+class SteamWorkshopGallery:
+    def __init__(self):
+        if sys.platform == "win32":
+            library_name = "steam_api64.dll" if sizeof(c_void_p) == 8 else "steam_api.dll"
+        elif sys.platform.startswith("linux"):
+            library_name = "libsteam_api.so"
+        elif sys.platform == "darwin":
+            library_name = "libsteam_api.dylib"
+        else:
+            raise SteamWorkshopGalleryError(
+                f"Gallery synchronization is not supported on platform '{sys.platform}'."
+            )
+
+        library_path = _steamworks_library_path(__file__, library_name)
+        if not os.path.isfile(library_path):
+            raise SteamWorkshopGalleryError(
+                f"Steamworks API library not found: {library_path}"
+            )
+
+        try:
+            self._api = ctypes.CDLL(library_path)
+            get_ugc_interface = getattr(self._api, STEAMWORKS_UGC_INTERFACE)
+        except (OSError, AttributeError) as exc:
+            raise SteamWorkshopGalleryError(
+                f"Could not load the Steamworks UGC API from '{library_path}': {exc}"
+            ) from exc
+
+        get_ugc_interface.restype = c_void_p
+        get_ugc_interface.argtypes = []
+        self._ugc = get_ugc_interface()
+        if not self._ugc:
+            raise SteamWorkshopGalleryError(
+                "Steamworks did not provide the ISteamUGC v016 interface."
+            )
+
+        self._add_preview = self._bind(
+            "SteamAPI_ISteamUGC_AddItemPreviewFile",
+            c_bool,
+            [c_void_p, c_uint64, c_char_p, c_int],
+        )
+        self._remove_preview = self._bind(
+            "SteamAPI_ISteamUGC_RemoveItemPreview",
+            c_bool,
+            [c_void_p, c_uint64, c_uint32],
+        )
+        self._create_details_request = self._bind(
+            "SteamAPI_ISteamUGC_CreateQueryUGCDetailsRequest",
+            c_uint64,
+            [c_void_p, POINTER(c_uint64), c_uint32],
+        )
+        self._set_return_additional_previews = self._bind(
+            "SteamAPI_ISteamUGC_SetReturnAdditionalPreviews",
+            c_bool,
+            [c_void_p, c_uint64, c_bool],
+        )
+        self._send_query = self._bind(
+            "SteamAPI_ISteamUGC_SendQueryUGCRequest",
+            c_uint64,
+            [c_void_p, c_uint64],
+        )
+        self._get_num_previews = self._bind(
+            "SteamAPI_ISteamUGC_GetQueryUGCNumAdditionalPreviews",
+            c_uint32,
+            [c_void_p, c_uint64, c_uint32],
+        )
+        self._get_preview = self._bind(
+            "SteamAPI_ISteamUGC_GetQueryUGCAdditionalPreview",
+            c_bool,
+            [
+                c_void_p,
+                c_uint64,
+                c_uint32,
+                c_uint32,
+                POINTER(c_char),
+                c_uint32,
+                POINTER(c_char),
+                c_uint32,
+                POINTER(c_int),
+            ],
+        )
+        self._release_query = self._bind(
+            "SteamAPI_ISteamUGC_ReleaseQueryUGCRequest",
+            c_bool,
+            [c_void_p, c_uint64],
+        )
+        self._register_call_result = self._bind(
+            "SteamAPI_RegisterCallResult",
+            None,
+            [POINTER(_CallbackBase), c_uint64],
+        )
+        self._unregister_call_result = self._bind(
+            "SteamAPI_UnregisterCallResult",
+            None,
+            [POINTER(_CallbackBase), c_uint64],
+        )
+
+    def _bind(self, name, return_type, argument_types):
+        try:
+            function = getattr(self._api, name)
+        except AttributeError as exc:
+            raise SteamWorkshopGalleryError(
+                f"The installed Steamworks API does not export {name}."
+            ) from exc
+        function.restype = return_type
+        function.argtypes = argument_types
+        return function
+
+    def add_item_preview_file(self, update_handle, path):
+        return bool(
+            self._add_preview(
+                self._ugc,
+                update_handle,
+                os.fsencode(os.path.abspath(path)),
+                EItemPreviewType.IMAGE.value,
+            )
+        )
+
+    def remove_item_preview(self, update_handle, preview_index):
+        return bool(self._remove_preview(self._ugc, update_handle, preview_index))
+
+    def get_additional_previews(self, published_file_id, steam):
+        if published_file_id <= 0:
+            raise SteamWorkshopGalleryError("A valid Workshop item ID is required.")
+
+        item_ids = (c_uint64 * 1)(published_file_id)
+        query_handle = self._create_details_request(self._ugc, item_ids, 1)
+        if not query_handle:
+            raise SteamWorkshopGalleryError(
+                "Steamworks could not create a Workshop details query."
+            )
+
+        callback = None
+        callback_pointer = None
+        call_handle = 0
+        callback_registered = False
+        try:
+            if not self._set_return_additional_previews(self._ugc, query_handle, True):
+                raise SteamWorkshopGalleryError(
+                    "Steamworks could not enable additional-preview query results."
+                )
+
+            callback, callback_state = self._make_query_callback()
+            callback_pointer = pointer(callback)
+            call_handle = self._send_query(self._ugc, query_handle)
+            if not call_handle:
+                raise SteamWorkshopGalleryError(
+                    "Steamworks could not submit the Workshop details query."
+                )
+            self._register_call_result(callback_pointer, call_handle)
